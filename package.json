{
  "name": "lessy-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio of Finehas Mpoe (Lessy). Static site, no build step. Served from dist/.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "lint": "html-validate dist/index.html",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "budget": "node scripts/budget.mjs",
    "check": "npm run lint && npm run test:unit && npm run budget",
    "test": "npm run check && npm run test:e2e",
    "capture": "node scripts/capture-work.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "images": "node scripts/make-images.mjs",
    "covers": "node scripts/apply-covers.mjs",
    "socials": "node scripts/build-socials.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "html-validate": "^11.17.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0"
  }
}
