{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lessy-mpoe-portfolio.vercel.app"
        }
      ],
      "destination": "https://lesiamon.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lessy-mpoe-portfolio-finehas-projects.vercel.app"
        }
      ],
      "destination": "https://lesiamon.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lessy-mpoe-portfolio-git-main-finehas-projects.vercel.app"
        }
      ],
      "destination": "https://lesiamon.com/:path*",
      "permanent": true
    }
  ]
}
